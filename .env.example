# .env.example — copy this file to .env and fill in your credentials
# Never commit .env to version control.

# ── Option A: Google Gemini (default) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini/gemini-3.8-flash

# ── Option B: Anthropic Claude ────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=claude-3-5-sonnet-20241022

# ── Option C: OpenAI ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL=gpt-4o-mini

# Other valid Gemini MODEL values:
#   gemini/gemini-2.0-flash          (fast, recommended default)
#   gemini/gemini-1.5-flash          (lightweight)
#   gemini/gemini-1.5-pro            (higher capability)
#   gemini/gemini-2.0-flash-thinking (reasoning model)
